# Copy to .env and fill in. NEVER commit .env or a private key.

# --- Arkiv (Rabdi testnet, chain 7794095) ---
# Free key: https://hub.arkiv.network/access-keys
ARKIV_ACCESS_KEY=
# Publisher wallet that writes all PreSign entities (testnet-only key!)
PUBLISHER_PRIVATE_KEY=
# Public address of the publisher. Readers only trust entities created by this address.
PUBLISHER_ADDRESS=

# --- Ethereum RPC (mainnet reads: eth_getCode, watchtower) ---
ETH_RPC_URL=

# --- GitHub (raises API limit from 60 to 5000 req/h for importer/keeper) ---
GITHUB_TOKEN=

# --- Clear-signing registry pin ---
REGISTRY_REPO=ethereum/clear-signing-erc7730-registry
REGISTRY_COMMIT=

# --- Swarm (optional bonus) ---
BEE_URL=
POSTAGE_BATCH_ID=

# --- Web app (exposed to the browser; never put secrets here) ---
VITE_ARKIV_ACCESS_KEY=
VITE_PUBLISHER_ADDRESS=
# Optional: your own Sepolia RPC (defaults to viem's public one)
VITE_SEPOLIA_RPC_URL=
